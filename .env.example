# Configuration file - copy to .env and modify as needed
# This file shows all available configuration options

# Flask Settings
FLASK_DEBUG=True
FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=127.0.0.1

# PDF Processing
PDF_DPI=200
MAX_PDF_SIZE_MB=10
PDF_TIMEOUT_SECONDS=30

# Room Detection
MIN_ROOM_AREA_PX=2000
MORPHOLOGY_KERNEL_SIZE=5
CONTOUR_APPROXIMATION_EPSILON=0.01

# ML Segmentation
ML_MODEL_PATH=model.pth
ML_INFERENCE_DEVICE=cpu
ML_SEGMENTATION_THRESHOLD=0.5

# Default Calculations
DEFAULT_PIXELS_PER_METER=100
DEFAULT_ROLL_WIDTH_M=3.66
DEFAULT_WASTE_PERCENT=10

# Output
OUTPUT_DIR=static/output
KEEP_OUTPUT_FILES_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
